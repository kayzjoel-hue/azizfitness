---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AZIZFITNESS | Success Stories">
    <section class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Success Stories</span>
          <h2>Transformations that prove the process works</h2>
          <p>Member journeys centered on strength, energy, confidence, and sustainable habits.</p>
        </div>
        <div class="success-grid">
          <article class="success-card">
            <img src="/results.jpg" alt="Transformation story">
            <h3>Fat loss success</h3>
            <p>“I lost 12 kg in 10 weeks and feel stronger than ever.”</p>
          </article>
          <article class="success-card">
            <img src="/coaches.jpg" alt="Team support">
            <h3>Strength boost</h3>
            <p>“The coaches helped me lift heavier safely and consistently.”</p>
          </article>
          <article class="success-card">
            <img src="/celebrating.jpg" alt="Community support">
            <h3>Community wins</h3>
            <p>“The group energy keeps me coming back every week.”</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container section-split reverse">
        <div class="section-image">
          <img src="/team.jpg" alt="Community training" loading="lazy">
        </div>
        <div class="section-copy">
          <span class="eyebrow">Testimonials</span>
          <h2>Real members, real results</h2>
          <p>From goal setting to achievement, our members share what keeps them motivated.</p>
          <div class="feature-list">
            <div><strong>Consistent coaching</strong><p>Members stay on track with structured programs.</p></div>
            <div><strong>Supportive community</strong><p>A positive training environment makes every session count.</p></div>
            <div><strong>Visible results</strong><p>Performance, body composition, and confidence growth.</p></div>
          </div>
          <a class="btn btn-primary" href="/contact">Share your success</a>
        </div>
      </div>
    </section>
</Layout>
