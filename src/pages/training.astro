---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AZIZFITNESS | Personal Training">
    <section class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Personal Training</span>
          <h2>Custom coaching for faster progress</h2>
          <p>One-on-one plans that adapt to your schedule, goals, and lifestyle.</p>
        </div>
        <div class="trainers-grid">
          <article class="trainer-card">
            <img src="/coach-aziz.jpg" alt="Coach Aziz">
            <h3>Coach Aziz</h3>
            <p>Strength and conditioning expert built for serious progress.</p>
          </article>
          <article class="trainer-card">
            <img src="/coach-sarah.jpg" alt="Coach Sarah">
            <h3>Coach Sarah</h3>
            <p>Nutrition and body recomposition specialist.</p>
          </article>
          <article class="trainer-card">
            <img src="/team.jpg" alt="Training team">
            <h3>Coach Team</h3>
            <p>Holistic support for programs and accountability.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Packages</span>
          <h2>Packages made for consistent gains</h2>
          <p>Every program includes coaching, check-ins, and performance tracking.</p>
        </div>
        <div class="package-grid">
          <article class="package-card">
            <h4>Starter</h4>
            <p>2 PT sessions + plan review</p>
          </article>
          <article class="package-card">
            <h4>Progress</h4>
            <p>Weekly coaching and nutrition support</p>
          </article>
          <article class="package-card">
            <h4>Transform</h4>
            <p>Custom program, monthly review, full support</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-light">
      <div class="container section-split reverse">
        <div class="section-image">
          <img src="/training.jpg" alt="Personal training" loading="lazy">
        </div>
        <div class="section-copy">
          <span class="eyebrow">Progress tracking</span>
          <h2>Stay accountable with coaching and milestones</h2>
          <p>We track your training, nutrition, and performance so every session moves you closer to your goals.</p>
          <div class="feature-list">
            <div><strong>Goal planning</strong><p>Start with a clear target and a roadmap to reach it.</p></div>
            <div><strong>Weekly reviews</strong><p>Adjust your program with expert guidance.</p></div>
            <div><strong>Accountability</strong><p>Coaches keep you consistent and motivated.</p></div>
          </div>
          <a class="btn btn-primary" href="/contact?interest=pt">Book a session</a>
        </div>
      </div>
    </section>
</Layout>
