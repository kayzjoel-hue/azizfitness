---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AZIZFITNESS | Modern OS-Style Premium Gym Dubai">
    <section id="home" class="hero-section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Premium gym Dubai</span>
          <h1>Train Strong. Live Better.</h1>
          <p>High-performance training, personal coaching, and wellness plans built for fast, measurable results.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#memberships">Book Free Trial</a>
            <a class="btn btn-secondary" href="https://wa.me/971523463618?text=Hi%20azizfitness,%20I%20want%20to%20start%20today">Start Today</a>
          </div>
          <div class="hero-stats">
            <div><strong>750+</strong><span>Members</span></div>
            <div><strong>35</strong><span>Coaches</span></div>
            <div><strong>25</strong><span>Class Types</span></div>
            <div><strong>8</strong><span>Years</span></div>
          </div>
        </div>
        <div class="hero-image">
          <img src="/hero.jpg" alt="Azizfitness Gym" loading="lazy">
        </div>
      </div>
    </section>
    
    <!-- Memberships Section -->
    <section id="memberships" class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Memberships</span>
          <h2>Choose the plan that fits your goals</h2>
          <p>High-value gym access, flexible training, and coaching support for every stage of your fitness journey.</p>
        </div>
        <div class="card-grid">
          <article class="plan-card">
            <h3>Monthly</h3>
            <p class="plan-price">AED 599<span>/mo</span></p>
            <ul>
              <li>Unlimited gym access</li>
              <li>Group classes included</li>
              <li>Sauna + recovery lounge</li>
            </ul>
            <a class="btn btn-primary" href="https://wa.me/971523463618?text=Hi%20azizfitness,%20I%20want%20details%20on%20the%20Monthly%20membership">Enquire</a>
          </article>
          <article class="plan-card plan-card-popular">
            <span class="badge">Most Popular</span>
            <h3>Annual</h3>
            <p class="plan-price">AED 5,999<span>/yr</span></p>
            <ul>
              <li>Save 15% on the monthly rate</li>
              <li>4 personal training sessions</li>
              <li>Nutrition plan included</li>
            </ul>
            <a class="btn btn-primary" href="https://wa.me/971523463618?text=Hi%20azizfitness,%20I%20want%20details%20on%20the%20Annual%20membership">Enquire</a>
          </article>
        </div>
      </div>
    </section>
</Layout>
