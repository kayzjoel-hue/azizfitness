---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AZIZFITNESS | Memberships">
    <section class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Memberships</span>
          <h2>Flexible plans built for every stage of your fitness journey</h2>
          <p>Choose a membership that fits your lifestyle, training frequency, and growth goals.</p>
        </div>
        <div class="card-grid">
          <article class="plan-card">
            <h3>Monthly</h3>
            <p class="plan-price">AED 599<span>/mo</span></p>
            <ul>
              <li>Unlimited gym access</li>
              <li>Group classes included</li>
              <li>Recovery lounge available</li>
              <li>Free body composition check-in</li>
            </ul>
            <a class="btn btn-primary" href="/contact?interest=membership&plan=monthly">Ask about Monthly</a>
          </article>
          <article class="plan-card plan-card-popular">
            <span class="badge">Most Popular</span>
            <h3>Annual</h3>
            <p class="plan-price">AED 5,999<span>/yr</span></p>
            <ul>
              <li>15% savings versus monthly</li>
              <li>4 guided personal training sessions</li>
              <li>Nutrition planning included</li>
              <li>Priority class booking</li>
            </ul>
            <a class="btn btn-primary" href="/contact?interest=membership&plan=annual">Ask about Annual</a>
          </article>
          <article class="plan-card">
            <h3>Student</h3>
            <p class="plan-price">AED 399<span>/mo</span></p>
            <ul>
              <li>Flexible access hours</li>
              <li>Student-friendly class schedule</li>
              <li>Nutrition support included</li>
              <li>Valid student ID required</li>
            </ul>
            <a class="btn btn-primary" href="/contact?interest=membership&plan=student">Ask about Student</a>
          </article>
          <article class="plan-card">
            <h3>Corporate</h3>
            <p class="plan-price">Custom<span>packages</span></p>
            <ul>
              <li>Team wellness packages</li>
              <li>Onsite coaching support</li>
              <li>Corporate discounts available</li>
              <li>Dedicated account manager</li>
            </ul>
            <a class="btn btn-primary" href="/contact?interest=membership&plan=corporate">Ask about Corporate</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container section-split">
        <div class="section-copy">
          <span class="eyebrow">Why choose us</span>
          <h2>Memberships that support real progress</h2>
          <p>Every plan is designed to deliver accountability, expert coaching, strong community energy, and measurable results.</p>
          <div class="feature-list">
            <div><strong>Proven results</strong><p>Programs built on data, consistency, and professional coaching.</p></div>
            <div><strong>Clear pricing</strong><p>No hidden fees, no surprises, just transparent value.</p></div>
            <div><strong>Community energy</strong><p>A motivating environment that keeps you accountable.</p></div>
            <div><strong>Flexible access</strong><p>Plans for individuals, students, teams, and performance seekers.</p></div>
          </div>
          <a class="btn btn-secondary" href="/contact">Book membership guidance</a>
        </div>
        <div class="section-image">
          <img src="/team.jpg" alt="Membership support" loading="lazy">
        </div>
      </div>
    </section>
</Layout>
