---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AZIZFITNESS | Resources">
    <section class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Resources</span>
          <h2>Fitness content and tools to keep you moving forward</h2>
          <p>Tips, events, and challenges designed to support your training and nutrition journey.</p>
        </div>
        <div class="resource-grid">
          <article class="resource-card"><h4>Blog</h4><p>Expert articles on training, recovery, and nutrition.</p></article>
          <article class="resource-card"><h4>Fitness Tips</h4><p>Quick guides to boost your workouts and improve recovery.</p></article>
          <article class="resource-card"><h4>Events</h4><p>Find workshops, fitness challenges, and community meetups.</p></article>
          <article class="resource-card"><h4>Challenges</h4><p>Short programs to test your progress and stay accountable.</p></article>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container section-split reverse">
        <div class="section-image">
          <img src="/coach-sarah.jpg" alt="Resources and coaching" loading="lazy">
        </div>
        <div class="section-copy">
          <span class="eyebrow">Stay informed</span>
          <h2>Knowledge is power for better fitness habits</h2>
          <p>Our resources are built to help you make smarter training decisions and stay consistent.</p>
          <div class="feature-list">
            <div><strong>Training insights</strong><p>Understand how workouts impact your goals.</p></div>
            <div><strong>Nutrition guides</strong><p>Simple advice that helps your meals support your training.</p></div>
            <div><strong>Event announcements</strong><p>Get updates on classes, workshops, and club activities.</p></div>
          </div>
          <a class="btn btn-primary" href="/contact">Get resource access</a>
        </div>
      </div>
    </section>
</Layout>
